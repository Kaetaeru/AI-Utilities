{
  "manifest_version": 3,
  "name": "Patient Oracle",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "description": "A persistent GitHub-backed ChatGPT worker with generated-file handoff, Server Mode recovery, and a 20-minute execution law.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": {
    "service_worker": "sidepanel-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Patient Oracle"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "artifact-preview-v2.js"],
      "run_at": "document_idle"
    }
  ]
}
