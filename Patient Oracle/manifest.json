{
  "manifest_version": 3,
  "name": "Patient Oracle",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "A GitHub-backed ChatGPT request/response worker with durable identity and a 20-minute execution law.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting", "tabs"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "sidepanel-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Patient Oracle"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
