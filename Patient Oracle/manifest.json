{
  "manifest_version": 3,
  "name": "Patient Oracle",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Patient Oracle with the 1.0 live multi-worker foundation: fresh ephemeral ChatGPT tabs per job alongside the verified 0.4 durable worker path.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "background": {
    "service_worker": "sidepanel-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Patient Oracle"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "artifact-preview-v2.js", "live-content.js", "live-artifact-preview.js"],
      "run_at": "document_idle"
    }
  ]
}
